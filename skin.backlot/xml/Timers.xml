<?xml version="1.0" encoding="UTF-8"?>
<timers>
	<!-- runs while playback is paused; the paused info screen appears after 3 seconds -->
	<timer>
		<name>backlot_paused</name>
		<description>Time since playback was paused</description>
		<start reset="true">Player.Paused + Window.IsActive(fullscreenvideo)</start>
		<stop>!Player.Paused | !Window.IsActive(fullscreenvideo)</stop>
	</timer>
	<!-- paused with the controls open and no button pressed for 5 seconds: close the
	     controls so the paused info screen can show (pausing with OK opens them) -->
	<timer>
		<name>backlot_osd_idle</name>
		<description>Closes the OSD after 5 idle seconds while paused</description>
		<start reset="true">Player.Paused + Window.IsActive(videoosd) + System.IdleTime(5) + !Skin.HasSetting(backlot.no_pausescreen) + !Window.IsActive(osdsubtitlesettings) + !Window.IsActive(osdaudiosettings) + !Window.IsActive(osdvideosettings) + !Window.IsActive(videobookmarks) + !Window.IsActive(sliderdialog)</start>
		<onstart>Dialog.Close(videoosd)</onstart>
		<stop>!Window.IsActive(videoosd)</stop>
	</timer>
	<!-- Backlot has no Videos menu: if Back from a library view Backlot opened lands on
	     the Videos root or a library category node, go home instead. Only fires when
	     Backlot launched the view (backlot.libnav), so opening Videos on purpose
	     (Files / Add videos) is left alone. -->
	<timer>
		<name>backlot_videos_root</name>
		<description>Sends the Videos root back to Home</description>
		<start reset="true">Window.IsActive(videos) + !Container.IsUpdating + !String.IsEmpty(Window(Home).Property(backlot.libnav)) + [String.IsEqual(Container.FolderPath,library://video/) | String.IsEqual(Container.FolderPath,videodb://) | String.IsEqual(Container.FolderPath,videodb://movies/) | String.IsEqual(Container.FolderPath,videodb://tvshows/) | String.IsEqual(Container.FolderPath,library://video/movies/) | String.IsEqual(Container.FolderPath,library://video/tvshows/)]</start>
		<onstart>ReplaceWindow(Home)</onstart>
		<stop>!Window.IsActive(videos)</stop>
	</timer>
</timers>
