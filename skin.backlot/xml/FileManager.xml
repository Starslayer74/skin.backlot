<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi's two-pane File manager (Settings > File manager). Kodi drives it through
     list 20 (left pane), list 21 (right pane), labels 101/102 (each pane's path)
     and progress 30. Adding a source is the "Add source" entry at the top level. -->
<window>
	<defaultcontrol always="true">20</defaultcontrol>
	<backgroundcolor>bg</backgroundcolor>
	<include>Anim_WindowFade</include>
	<controls>
		<include>Background</include>
		<control type="label">
			<left>120</left>
			<top>50</top>
			<width>1200</width>
			<height>70</height>
			<font>f_title</font>
			<label>$LOCALIZE[7]</label>
		</control>
		<include>Clock</include>

		<control type="label" id="101">
			<left>120</left>
			<top>150</top>
			<width>820</width>
			<height>40</height>
			<font>f_small</font>
			<textcolor>text3</textcolor>
		</control>
		<control type="label" id="102">
			<left>980</left>
			<top>150</top>
			<width>820</width>
			<height>40</height>
			<font>f_small</font>
			<textcolor>text3</textcolor>
		</control>

		<control type="image">
			<left>108</left>
			<top>196</top>
			<width>844</width>
			<height>780</height>
			<texture border="24" colordiffuse="surface">frame/rounded24.png</texture>
		</control>
		<control type="image">
			<left>968</left>
			<top>196</top>
			<width>844</width>
			<height>780</height>
			<texture border="24" colordiffuse="surface">frame/rounded24.png</texture>
		</control>

		<control type="list" id="20">
			<left>120</left>
			<top>208</top>
			<width>820</width>
			<height>760</height>
			<onleft>21</onleft>
			<onright>21</onright>
			<onup>20</onup>
			<ondown>20</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="FileManagerLayouts">
				<param name="id">20</param>
			</include>
		</control>
		<control type="list" id="21">
			<left>980</left>
			<top>208</top>
			<width>820</width>
			<height>760</height>
			<onleft>20</onleft>
			<onright>20</onright>
			<onup>21</onup>
			<ondown>21</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="FileManagerLayouts">
				<param name="id">21</param>
			</include>
		</control>

		<control type="progress" id="30">
			<left>120</left>
			<top>990</top>
			<width>1680</width>
			<height>8</height>
			<visible>false</visible>
		</control>
		<control type="label">
			<left>120</left>
			<top>1000</top>
			<width>1680</width>
			<height>40</height>
			<font>f_small</font>
			<textcolor>text3</textcolor>
			<label>OK opens  •  Left and right switch sides  •  Menu (or long press) for copy, move, delete, rename and source options</label>
		</control>
	</controls>
</window>
