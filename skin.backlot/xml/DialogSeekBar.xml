<?xml version="1.0" encoding="UTF-8"?>
<!-- Player overlay shown while seeking, paused, with the info key, or under
     the OSD (the OSD only adds the buttons). After a few seconds of pause it
     becomes the paused info screen: the picture dims and the title, plot and
     time left take over the middle of the screen. -->
<window>
	<visible>Window.IsActive(fullscreenvideo)</visible>
	<visible>!Window.IsActive(sliderdialog)</visible>
	<visible>Player.Seeking | Player.HasPerformedSeek(3) | [Player.Paused + !Player.Caching] | Player.Forwarding | Player.Rewinding | Player.ShowInfo | Window.IsActive(fullscreeninfo) | Player.ShowTime | Window.IsActive(videoosd) | !String.IsEmpty(Player.SeekNumeric)</visible>
	<zorder>0</zorder>
	<animation type="WindowOpen" reversible="false">
		<effect type="fade" start="0" end="100" time="200" />
		<effect type="slide" start="0,80" end="0,0" time="240" tween="cubic" easing="out" />
	</animation>
	<animation type="WindowClose" reversible="false">
		<effect type="fade" start="100" end="0" time="160" />
	</animation>
	<controls>
		<!-- ===================================================== paused info screen -->
		<control type="group">
			<visible>$EXP[backlot_pausescreen]</visible>
			<animation effect="fade" start="0" end="100" time="500" tween="sine">Visible</animation>
			<animation effect="fade" start="100" end="0" time="200">Hidden</animation>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>1080</height>
				<texture colordiffuse="B3000000">colors/white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1300</width>
				<height>1080</height>
				<texture colordiffuse="CC000000">frame/grad_left.png</texture>
			</control>
			<control type="group">
				<left>120</left>
				<top>210</top>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>1000</width>
					<height>36</height>
					<font>f_small</font>
					<textcolor>accent</textcolor>
					<label>[UPPERCASE]$VAR[PauseKicker][/UPPERCASE]</label>
				</control>
				<control type="image">
					<left>0</left>
					<top>48</top>
					<width>640</width>
					<height>220</height>
					<aspectratio align="left" aligny="bottom">keep</aspectratio>
					<texture>$VAR[PlayerLogo]</texture>
				</control>
				<control type="label">
					<left>0</left>
					<top>48</top>
					<width>1100</width>
					<height>220</height>
					<aligny>bottom</aligny>
					<font>f_hero</font>
					<wrapmultiline>true</wrapmultiline>
					<label>$VAR[PlayerTitle]</label>
					<visible>String.IsEmpty(Player.Art(clearlogo)) + String.IsEmpty(Player.Art(tvshow.clearlogo))</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>290</top>
					<width>1100</width>
					<height>44</height>
					<font>f_sub</font>
					<label>$VAR[PausedHeadline]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>340</top>
					<width>1100</width>
					<height>40</height>
					<font>f_body</font>
					<textcolor>text2</textcolor>
					<label>$VAR[PausedMeta]</label>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>396</top>
					<width>1000</width>
					<height>180</height>
					<font>f_body</font>
					<textcolor>text2</textcolor>
					<label>$INFO[VideoPlayer.Plot]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>600</top>
					<width>1100</width>
					<height>44</height>
					<font>f_body_m</font>
					<label>$INFO[Player.TimeRemaining,, left]$INFO[Player.FinishTime,  •  Ends at ,]</label>
				</control>
			</control>
		</control>

		<!-- ===================================================== bottom strip -->
		<control type="image">
			<left>0</left>
			<top>560</top>
			<width>1920</width>
			<height>520</height>
			<texture colordiffuse="F2000000">frame/grad_bottom.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>220</height>
			<texture colordiffuse="CC000000">frame/grad_top.png</texture>
			<visible>Window.IsActive(videoosd) | Player.ShowInfo | Window.IsActive(fullscreeninfo) | $EXP[backlot_pausescreen]</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
		</control>
		<control type="group">
			<left>120</left>
			<top>0</top>
			<width>1680</width>
			<!-- title (gives way to the paused info screen) -->
			<control type="group">
				<animation effect="fade" start="100" end="0" time="300" condition="$EXP[backlot_pausescreen]">Conditional</animation>
				<control type="image">
					<left>0</left>
					<top>700</top>
					<width>440</width>
					<height>120</height>
					<aspectratio align="left" aligny="bottom">keep</aspectratio>
					<texture>$VAR[PlayerLogo]</texture>
				</control>
				<control type="label">
					<left>0</left>
					<top>740</top>
					<width>1400</width>
					<height>80</height>
					<aligny>bottom</aligny>
					<font>f_title</font>
					<label>$VAR[PlayerTitle]</label>
					<visible>String.IsEmpty(Player.Art(clearlogo)) + String.IsEmpty(Player.Art(tvshow.clearlogo))</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>828</top>
					<width>1400</width>
					<height>40</height>
					<font>f_body_m</font>
					<textcolor>text2</textcolor>
					<label>$VAR[PlayerSubtitle]</label>
				</control>
			</control>
			<!-- progress: track, buffered, played, then chapter notches over all three -->
			<control type="progress">
				<left>0</left>
				<top>894</top>
				<width>1680</width>
				<height>10</height>
				<info>Player.ProgressCache</info>
				<texturebg border="5" colordiffuse="33FFFFFF">frame/rounded8.png</texturebg>
				<midtexture border="5" colordiffuse="1AFFFFFF">frame/rounded8.png</midtexture>
			</control>
			<control type="progress">
				<left>0</left>
				<top>894</top>
				<width>1680</width>
				<height>10</height>
				<info>Player.Progress</info>
				<texturebg border="5" colordiffuse="01FFFFFF">frame/rounded8.png</texturebg>
				<midtexture border="5" colordiffuse="accent">frame/rounded8.png</midtexture>
			</control>
			<control type="ranges">
				<left>0</left>
				<top>894</top>
				<width>1680</width>
				<height>10</height>
				<texturebg>colors/clear.png</texturebg>
				<lefttexture colordiffuse="E6000000">frame/tick.png</lefttexture>
				<midtexture>colors/clear.png</midtexture>
				<righttexture>colors/clear.png</righttexture>
				<info>Player.Chapters</info>
				<visible>Integer.IsGreater(Player.ChapterCount,1)</visible>
			</control>
			<control type="slider" id="401">
				<description>invisible: lets a mouse/touch seek on the bar</description>
				<left>0</left>
				<top>880</top>
				<width>1680</width>
				<height>40</height>
				<texturesliderbar>colors/clear.png</texturesliderbar>
				<textureslidernib>colors/clear.png</textureslidernib>
				<textureslidernibfocus>colors/clear.png</textureslidernibfocus>
				<visible>Player.SeekEnabled</visible>
			</control>
			<!-- time row -->
			<control type="label">
				<left>0</left>
				<top>922</top>
				<width>900</width>
				<height>40</height>
				<font>f_body_m</font>
				<label>[B]$VAR[SeekTime][/B][COLOR text2]$VAR[ChapterInfo][/COLOR]</label>
			</control>
			<control type="label">
				<right>0</right>
				<top>922</top>
				<width>700</width>
				<height>40</height>
				<align>right</align>
				<font>f_body_m</font>
				<textcolor>text2</textcolor>
				<label>$INFO[Player.TimeRemaining,-,  •  ]$INFO[Player.FinishTime,Ends ,]</label>
			</control>
			<control type="label">
				<left>440</left>
				<top>922</top>
				<width>800</width>
				<height>40</height>
				<align>center</align>
				<font>f_body_m</font>
				<textcolor>accent</textcolor>
				<label>$INFO[Player.SeekStepSize]$INFO[Player.SeekNumeric]</label>
			</control>
			<!-- paused / speed badge -->
			<control type="group">
				<right>0</right>
				<top>772</top>
				<width>220</width>
				<height>56</height>
				<visible>Player.Forwarding | Player.Rewinding | Player.Paused</visible>
				<animation effect="fade" start="100" end="0" time="300" condition="$EXP[backlot_pausescreen]">Conditional</animation>
				<control type="image">
					<texture border="28" colordiffuse="B3000000">frame/pill.png</texture>
				</control>
				<control type="label">
					<width>220</width>
					<height>56</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>f_body_m</font>
					<label>$INFO[Player.PlaySpeed,,x]</label>
					<visible>Player.Forwarding | Player.Rewinding</visible>
				</control>
				<control type="label">
					<width>220</width>
					<height>56</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>f_body_m</font>
					<label>$LOCALIZE[112]</label>
					<visible>Player.Paused + !Player.Forwarding + !Player.Rewinding</visible>
				</control>
			</control>
		</control>
		<!-- top: clock -->
		<control type="label">
			<right>80</right>
			<top>44</top>
			<width>300</width>
			<height>44</height>
			<align>right</align>
			<font>f_clock</font>
			<shadowcolor>shadow</shadowcolor>
			<label>$INFO[System.Time]</label>
			<visible>Window.IsActive(videoosd) | Player.ShowInfo | Window.IsActive(fullscreeninfo) | $EXP[backlot_pausescreen]</visible>
		</control>
	</controls>
</window>
