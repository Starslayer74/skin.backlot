<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>3</defaultcontrol>
	<backgroundcolor>bg</backgroundcolor>
	<include>Anim_WindowFade</include>
	<controls>
		<include>Background</include>
		<!-- category column -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>560</width>
			<height>1080</height>
			<texture colordiffuse="surface">colors/white.png</texture>
		</control>
		<control type="label">
			<left>70</left>
			<top>50</top>
			<width>440</width>
			<height>60</height>
			<font>f_head</font>
			<label>$LOCALIZE[5]</label>
		</control>
		<control type="grouplist" id="3">
			<left>50</left>
			<top>140</top>
			<width>460</width>
			<height>780</height>
			<itemgap>6</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<onleft>5</onleft>
			<onright>5</onright>
			<onup>3</onup>
			<ondown>20</ondown>
		</control>
		<control type="button" id="10">
			<description>Category button template</description>
			<width>460</width>
			<height>76</height>
			<textoffsetx>32</textoffsetx>
			<texturenofocus />
		</control>
		<include content="SettingsLevelButton">
			<param name="left">50</param>
			<param name="top">960</param>
			<param name="width">460</param>
		</include>

		<!-- settings list -->
		<control type="label">
			<left>640</left>
			<top>50</top>
			<width>1100</width>
			<height>60</height>
			<font>f_head</font>
			<label>$INFO[Control.GetLabel(2)]</label>
		</control>
		<include>Clock</include>
		<control type="grouplist" id="5">
			<left>620</left>
			<top>140</top>
			<width>1180</width>
			<height>780</height>
			<itemgap>4</itemgap>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>60</onright>
			<onup>5</onup>
			<ondown>5</ondown>
		</control>
		<include content="SettingTemplates">
			<param name="width">1180</param>
		</include>
		<control type="scrollbar" id="60">
			<left>1830</left>
			<top>140</top>
			<width>8</width>
			<height>780</height>
			<onleft>5</onleft>
			<onright>3</onright>
		</control>
		<control type="textbox" id="6">
			<left>650</left>
			<top>950</top>
			<width>1150</width>
			<height>100</height>
			<font>f_small</font>
			<textcolor>text2</textcolor>
			<autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
		</control>
		<control type="label" id="2">
			<description>breadcrumb (read by the header)</description>
			<visible>false</visible>
		</control>
	</controls>
</window>
