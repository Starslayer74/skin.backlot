	<!-- ============================================================ home row -->
	<include name="HomeRow">
		<definition>
			<control type="group">
				<top>$PARAM[top]</top>
				<control type="label">
					<left>120</left>
					<top>0</top>
					<width>1400</width>
					<height>40</height>
					<font>f_sub</font>
					<label>$PARAM[label]</label>
				</control>
				<control type="label">
					<left>120</left>
					<top>60</top>
					<width>1400</width>
					<height>60</height>
					<font>f_body</font>
					<textcolor>text3</textcolor>
					<label>Nothing here yet.</label>
					<visible>!Integer.IsGreater(Container($PARAM[id]).NumItems,0) + !Container($PARAM[id]).IsUpdating</visible>
				</control>
				<control type="list" id="$PARAM[id]">
					<left>106</left>
					<top>40</top>
					<width>1814</width>
					<height>250</height>
					<orientation>horizontal</orientation>
					<onleft>$PARAM[id]</onleft>
					<onright>$PARAM[id]</onright>
					<onup condition="!Skin.HasSetting(backlot.circles)">$PARAM[onup]</onup>
					<onup condition="Skin.HasSetting(backlot.circles)">$PARAM[onup_circles]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<itemlayout width="348" height="250">
						<include content="LandscapeItem">
							<param name="cid">$PARAM[id]</param>
						</include>
					</itemlayout>
					<focusedlayout width="348" height="250">
						<include content="LandscapeItemFocused">
							<param name="cid">$PARAM[id]</param>
						</include>
					</focusedlayout>
					<content target="videos">$PARAM[path]</content>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============================================================ hub row -->
	<include name="HubRow">
		<definition>
			<control type="list" id="$PARAM[id]">
				<left>106</left>
				<top>40</top>
				<width>1814</width>
				<height>250</height>
				<orientation>horizontal</orientation>
				<onleft>$PARAM[id]</onleft>
				<onright>$PARAM[id]</onright>
				<onup>10$PARAM[tab]</onup>
				<ondown>$PARAM[id]</ondown>
				<visible>$PARAM[visible]</visible>
				<itemlayout width="348" height="250">
					<include content="LandscapeItem">
						<param name="cid">$PARAM[id]</param>
					</include>
				</itemlayout>
				<focusedlayout width="348" height="250">
					<include content="LandscapeItemFocused">
						<param name="cid">$PARAM[id]</param>
					</include>
				</focusedlayout>
				<content target="videos">$PARAM[path]</content>
			</control>
		</definition>
	</include>

	<!-- ============================================================ library chrome -->
	<include name="LibraryHeader">
		<control type="group">
			<left>120</left>
			<top>40</top>
			<width>1300</width>
			<height>90</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>420</width>
				<height>90</height>
				<aspectratio align="left">keep</aspectratio>
				<texture>$VAR[HeaderLogo]</texture>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>1300</width>
				<height>90</height>
				<aligny>center</aligny>
				<font>f_head</font>
				<label>$VAR[BrowseHeader]</label>
				<visible>String.IsEmpty(Container.Art(tvshow.clearlogo)) + String.IsEmpty(Container.Art(set.clearlogo))</visible>
				<visible>![Container.Content(seasons) | Container.Content(episodes)] | String.IsEmpty(Container.Art(tvshow.clearlogo))</visible>
			</control>
		</control>
		<control type="label">
			<right>80</right>
			<top>92</top>
			<width>500</width>
			<height>36</height>
			<align>right</align>
			<font>f_small</font>
			<textcolor>text2</textcolor>
			<label>$INFO[Container.CurrentItem]$INFO[Container.NumItems, of ,]</label>
			<visible>Integer.IsGreater(Container.NumItems,0)</visible>
		</control>
		<control type="label">
			<right>80</right>
			<top>1028</top>
			<width>1200</width>
			<height>36</height>
			<align>right</align>
			<font>f_small</font>
			<textcolor>text3</textcolor>
			<label>Press left for view and sort options</label>
			<visible>!ControlGroup(9000).HasFocus()</visible>
			<animation effect="fade" start="100" end="0" time="400" delay="4000">WindowOpen</animation>
		</control>
	</include>

	<!-- focused item details used above the poster and episode views -->
	<include name="FocusedItemInfo">
