<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- ============================================================ OSD button -->
	<include name="OSDPill">
		<param name="left" />
		<param name="right" />
		<param name="width">240</param>
		<param name="visible">true</param>
		<definition>
			<control type="group">
				<width>$PARAM[width]</width>
				<height>84</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>8</top>
					<width>$PARAM[width]</width>
					<height>68</height>
					<label />
					<texturefocus border="34" colordiffuse="focus">frame/pill.png</texturefocus>
					<texturenofocus border="34" colordiffuse="66000000">frame/pill.png</texturenofocus>
					<onclick>$PARAM[onclick]</onclick>
					<onleft>$PARAM[left]</onleft>
					<onright>$PARAM[right]</onright>
				</control>
				<control type="image">
					<left>22</left>
					<top>26</top>
					<width>32</width>
					<height>32</height>
					<texture colordiffuse="text">$PARAM[icon]</texture>
					<visible>!Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="image">
					<left>22</left>
					<top>26</top>
					<width>32</width>
					<height>32</height>
					<texture colordiffuse="on_focus">$PARAM[icon]</texture>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="label">
					<left>66</left>
					<top>8</top>
					<width>$PARAM[labelwidth]</width>
					<height>68</height>
					<aligny>center</aligny>
					<font>f_body_m</font>
					<textcolor>text</textcolor>
					<label>$PARAM[label]</label>
					<visible>!Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="label">
					<left>66</left>
					<top>8</top>
					<width>$PARAM[labelwidth]</width>
					<height>68</height>
					<aligny>center</aligny>
					<font>f_body_m</font>
					<textcolor>on_focus</textcolor>
					<label>$PARAM[label]</label>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>
	<include name="OSDButton">
		<param name="left" />
		<param name="right" />
		<param name="size">84</param>
		<param name="visible">true</param>
		<param name="icon_alt"></param>
		<param name="alt_condition">false</param>
		<definition>
			<control type="group">
				<width>$PARAM[size]</width>
				<height>$PARAM[size]</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<width>$PARAM[size]</width>
					<height>$PARAM[size]</height>
					<label />
					<texturefocus colordiffuse="focus">masks/circle.png</texturefocus>
					<texturenofocus />
					<onclick>$PARAM[onclick]</onclick>
					<onleft>$PARAM[left]</onleft>
					<onright>$PARAM[right]</onright>
				</control>
				<control type="image">
					<left>20</left>
					<top>20</top>
					<width>44</width>
					<height>44</height>
					<texture colordiffuse="text">$PARAM[icon]</texture>
					<visible>!Control.HasFocus($PARAM[id]) + !$PARAM[alt_condition]</visible>
				</control>
				<control type="image">
					<left>20</left>
					<top>20</top>
					<width>44</width>
					<height>44</height>
					<texture colordiffuse="on_focus">$PARAM[icon]</texture>
					<visible>Control.HasFocus($PARAM[id]) + !$PARAM[alt_condition]</visible>
				</control>
				<control type="image">
					<left>20</left>
					<top>20</top>
					<width>44</width>
					<height>44</height>
					<texture colordiffuse="text">$PARAM[icon_alt]</texture>
					<visible>!Control.HasFocus($PARAM[id]) + $PARAM[alt_condition]</visible>
				</control>
				<control type="image">
					<left>20</left>
					<top>20</top>
					<width>44</width>
					<height>44</height>
					<texture colordiffuse="on_focus">$PARAM[icon_alt]</texture>
					<visible>Control.HasFocus($PARAM[id]) + $PARAM[alt_condition]</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============================================================ top bar icon -->
	<include name="TopIcon">
		<param name="onclick"></param>
		<param name="left" />
		<param name="right" />
		<definition>
			<control type="group">
				<width>72</width>
				<height>72</height>
				<control type="button" id="$PARAM[id]">
					<width>72</width>
					<height>72</height>
					<label />
					<texturefocus colordiffuse="focus">masks/circle.png</texturefocus>
					<texturenofocus colordiffuse="26FFFFFF">masks/circle.png</texturenofocus>
					<onclick>$PARAM[onclick]</onclick>
					<onleft>$PARAM[left]</onleft>
					<onright>$PARAM[right]</onright>
					<onup>$PARAM[id]</onup>
					<ondown condition="Skin.HasSetting(backlot.circles)">301</ondown>
					<ondown condition="!Skin.HasSetting(backlot.circles)">300</ondown>
				</control>
				<control type="image">
					<left>18</left>
					<top>18</top>
					<width>36</width>
					<height>36</height>
					<texture colordiffuse="text">$PARAM[icon]</texture>
					<visible>!Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="image">
					<left>18</left>
					<top>18</top>
					<width>36</width>
					<height>36</height>
					<texture colordiffuse="on_focus">$PARAM[icon]</texture>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============================================================ landscape card -->
	<include name="LandscapeItem">
		<param name="cid" />
		<definition>
			<control type="group">
				<left>14</left>
				<top>14</top>
				<width>320</width>
				<height>180</height>
				<animation effect="fade" start="100" end="60" time="150" condition="Control.HasFocus($PARAM[cid])">Conditional</animation>
				<control type="image">
					<texture border="16" colordiffuse="surface2">frame/rounded16.png</texture>
				</control>
				<control type="label">
					<left>20</left>
					<right>20</right>
					<align>center</align>
					<aligny>center</aligny>
					<font>f_body_m</font>
					<label>$INFO[ListItem.Label]</label>
					<visible>String.IsEmpty(ListItem.Art(landscape)) + String.IsEmpty(ListItem.Art(fanart)) + String.IsEmpty(ListItem.Art(thumb)) + String.IsEmpty(ListItem.Art(tvshow.fanart))</visible>
				</control>
				<control type="image">
					<aspectratio scalediffuse="false">scale</aspectratio>
					<texture background="true" diffuse="masks/thumb.png">$VAR[LandscapeArt]</texture>
				</control>
				<include>WatchedBadge</include>
				<include>ResumeBar</include>
			</control>
		</definition>
	</include>
	<include name="LandscapeItemFocused">
		<param name="cid" />
		<definition>
			<control type="group">
				<left>14</left>
				<top>14</top>
				<width>320</width>
				<height>180</height>
				<animation effect="zoom" end="108" center="auto" time="200" tween="cubic" easing="out" condition="Control.HasFocus($PARAM[cid])">Conditional</animation>
				<control type="image">
					<left>-40</left>
					<top>-40</top>
					<right>-40</right>
					<bottom>-40</bottom>
					<texture border="64">frame/shadow.png</texture>
					<visible>Control.HasFocus($PARAM[cid])</visible>
				</control>
				<control type="image">
					<texture border="16" colordiffuse="surface2">frame/rounded16.png</texture>
				</control>
				<control type="label">
					<left>20</left>
					<right>20</right>
					<align>center</align>
					<aligny>center</aligny>
					<font>f_body_m</font>
					<label>$INFO[ListItem.Label]</label>
					<visible>String.IsEmpty(ListItem.Art(landscape)) + String.IsEmpty(ListItem.Art(fanart)) + String.IsEmpty(ListItem.Art(thumb)) + String.IsEmpty(ListItem.Art(tvshow.fanart))</visible>
				</control>
				<control type="image">
					<aspectratio scalediffuse="false">scale</aspectratio>
					<texture background="true" diffuse="masks/thumb.png">$VAR[LandscapeArt]</texture>
				</control>
				<include>WatchedBadge</include>
				<include>ResumeBar</include>
				<control type="image">
					<left>-6</left>
					<top>-6</top>
					<right>-6</right>
					<bottom>-6</bottom>
					<texture border="20" colordiffuse="ring">frame/ring16.png</texture>
					<visible>Control.HasFocus($PARAM[cid])</visible>
				</control>
			</control>
			<control type="label">
				<left>14</left>
				<top>206</top>
				<width>320</width>
				<height>34</height>
				<font>f_body_m</font>
				<scroll>true</scroll>
				<label>$INFO[ListItem.Label]</label>
				<visible>Control.HasFocus($PARAM[cid])</visible>
			</control>
		</definition>
	</include>

